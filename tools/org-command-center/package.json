{
  "name": "org-command-center",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "voice:setup": "bash scripts/voice-setup.sh",
    "voice:up": "bash scripts/voice-up.sh",
    "say-tts:up": "bash scripts/say-tts-up.sh",
    "mlx-tts:setup": "bash scripts/mlx-tts-setup.sh",
    "mlx-tts:up": "bash scripts/mlx-tts-up.sh",
    "voice:health": "curl -sf http://127.0.0.1:3900/v1/models >/dev/null || curl -sf http://127.0.0.1:3900/health >/dev/null && echo online || echo offline",
    "livekit:up": "bash scripts/livekit-up.sh",
    "whisper:up": "bash scripts/whisper-up.sh",
    "voice-stack": "bash scripts/voice-stack-up.sh",
    "agent:dev": "npm --prefix livekit-agent run dev",
    "agent:test": "npm --prefix livekit-agent test",
    "jarvis:smoke": "bash livekit-agent/scripts/smoke-ollama-tools.sh",
    "jarvis:eval:ollama": "node server/jarvis/eval/ollama-eval.mjs"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.23",
    "@hono/node-server": "^2.0.10",
    "@livekit/components-react": "^2.9.17",
    "@livekit/protocol": "^1.43.2",
    "@livekit/components-react": "^2.9.23",
    "@livekit/protocol": "^1.50.0",
    "@react-spring/three": "^10.1.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "gray-matter": "^4.0.3",
    "hono": "^4.12.30",
    "livekit-client": "^2.20.1",
    "livekit-server-sdk": "^2.17.0",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
